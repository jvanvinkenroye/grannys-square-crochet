---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Ueber | Granny Square Crochet">
  <section class="container">
    <div class="section-title">
      <div>
        <h1>Ueber das Studio</h1>
        <p style="color: var(--muted); margin: 0;">
          Eine kleine Werkstatt fuer grosse Decken und neue Muster.
        </p>
      </div>
    </div>
    <div class="hero-card">
      <h2>Unsere Idee</h2>
      <p>
        Granny Squares sind zeitlos. Wir sammeln moderne Farben, klare Schritte
        und eine Haeckelschrift, die sofort sitzt. Hier findest du Inspiration,
        die zu deinem Tempo passt.
      </p>
    </div>
  </section>
</BaseLayout>
