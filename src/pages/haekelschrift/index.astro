---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import HeroCard from '../../components/HeroCard.astro';
import Pill from '../../components/Pill.astro';
import { getCollection } from 'astro:content';

const glossary = await getCollection('glossary');
---

<BaseLayout title="Haeckelschrift | Granny Square Crochet">
  <section class="container">
    <div class="section-title">
      <div>
        <h1>Haeckelschrift</h1>
        <p style="color: var(--muted); margin: 0;">
          Symbole, Abkuerzungen und eine klare Druckansicht.
        </p>
      </div>
      <Pill text="Glossar" />
    </div>

    <HeroCard>
      <h2>Kurze Legende</h2>
      <p>
        Diese Uebersicht verbindet die wichtigsten Symbole mit klaren Begriffen.
        Drucke dir die Liste fuer dein Projektbuch aus.
      </p>
      <div class="cards" style="margin-top: 1.5rem;">
        {
          glossary.map((entry) => (
            <Card title={entry.data.term} content={entry.data.meaning} />
          ))
        }
      </div>
    </HeroCard>
  </section>
</BaseLayout>
