---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import HeroCard from '../components/HeroCard.astro';
import Pill from '../components/Pill.astro';
import CTAButton from '../components/CTAButton.astro';
import { getCollection } from 'astro:content';
import { Image } from "astro:assets";
import heroImage from "../assets/hero-image.png";

const highlights = await getCollection('highlights');
---

<BaseLayout
  title="Granny Square Crochet"
  description="Moderne Haeckel-Tutorials, inspirierende Galerie und klare Haeckelschrift."
>
  <section class="container hero-layout">
    <div class="hero-content">
      <HeroCard style="height: 100%; display: flex; flex-direction: column; justify-content: center;">
        <Pill text="Granny Square Studio" />
        <h1 style="margin-top: 0.5rem;">Moderne Granny Squares mit Stil, Struktur und Herz.</h1>
        <p>
          Entdecke klare Schritt-fuer-Schritt-Anleitungen, kuratierte Farbkombis
          und eine Galerie, die Lust aufs Naechste Projekt macht.
        </p>
        <div class="cta-row">
          <CTAButton href="/tutorials/" text="Zu den Tutorials" />
          <CTAButton href="/gallery/" text="Galerie ansehen" secondary={true} />
        </div>
      </HeroCard>
    </div>
    
    <div class="hero-image">
        <Image 
            src={heroImage} 
            alt="Gemütlicher Häkelplatz mit Wolle und Nadel" 
            width={800} 
            height={800} 
            style="width: 100%; height: 100%; object-fit: cover;"
            loading="eager"
        />
    </div>
  </section>

  <section class="container">
      <div class="section-title">
          <div>
            <h2>Heute im Fokus</h2>
            <p style="color: var(--muted); margin: 0; max-width: 60ch;">
                Kleine Haeckelpausen mit grossem Effekt: Kombinationen aus zwei Farben,
                drei Reihen und einem Twist im Abschluss.
            </p>
          </div>
      </div>
      <div class="cards">
        {
          highlights.map((item) => (
            <Card
              title={item.data.title}
              tag={item.data.level}
              content={item.data.time}
            />
          ))
        }
      </div>
  </section>

  <section class="container">
    <div class="section-title">
      <div>
        <h2>Was dich erwartet</h2>
        <p style="color: var(--muted); margin: 0;">
          Drei klare Bereiche fuer deinen Workflow von der Idee bis zur Decke.
        </p>
      </div>
    </div>
    <div class="cards">
      <Card
        title="Tutorials mit Struktur"
        content="Schrittbilder, Materiallisten und Zeitplanung fuer jede Technik."
      />
      <Card
        title="Galerie & Farbideen"
        content="Sammle Inspiration und filtere nach Mood, Saison oder Motiv."
      />
      <Card
        title="Haeckelschrift klar erklaert"
        content="Ein Glossar mit Symbolen, Druckansicht und Download-Optionen."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 3rem 0 4rem;
  }

  .hero-image {
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--shadow);
    min-height: 300px;
    opacity: 0;
    animation: float-in 0.8s ease forwards 0.2s;
  }

  @media (min-width: 850px) {
    .hero-layout {
      display: grid;
      grid-template-columns: 1.2fr 0.9fr;
      align-items: stretch;
      gap: 2.5rem;
    }

    .hero-image {
      height: 100%;
      min-height: auto;
    }
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>