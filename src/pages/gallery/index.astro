---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Pill from '../../components/Pill.astro';
import { getCollection } from 'astro:content';

const gallery = await getCollection('gallery');
---

<BaseLayout title="Galerie | Granny Square Crochet">
  <section class="container">
    <div class="section-title">
      <div>
        <h1>Galerie</h1>
        <p style="color: var(--muted); margin: 0;">
          Farbgeschichten, Musterideen und fertige Kombinationen.
        </p>
      </div>
      <Pill text="Filter: Mood, Farben, Motiv" />
    </div>

    <div class="cards">
      {
        gallery.map((item) => (
          <Card
            title={item.data.title}
            tag={item.data.mood}
            content={item.data.colors}
          >
            <div
              style="
              height: 140px;
              border-radius: 18px;
              background: linear-gradient(135deg, #f3b597, #efe3d4);
              margin-bottom: 1rem;
            "
            />
          </Card>
        ))
      }
    </div>
  </section>
</BaseLayout>
