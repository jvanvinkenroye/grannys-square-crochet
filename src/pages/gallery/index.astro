---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Pill from '../../components/Pill.astro';
import { getCollection } from 'astro:content';

import { Image } from 'astro:assets';

const gallery = await getCollection('gallery');
---

<BaseLayout title="Galerie | Granny Square Crochet">
  <section class="container">
    <div class="section-title">
      <div>
        <h1>Galerie</h1>
        <p style="color: var(--muted); margin: 0;">
          Farbgeschichten, Musterideen und fertige Kombinationen.
        </p>
      </div>
      <Pill text="Filter: Mood, Farben, Motiv" />
    </div>

    <div class="cards">
      {
        gallery.map((item) => (
          <Card
            title={item.data.title}
            tag={item.data.mood}
            content={item.data.colors}
          >
            <div
              style="
              margin-bottom: 1rem;
              border-radius: 18px;
              overflow: hidden;
            "
            >
              <Image
                src={item.data.image}
                alt={item.data.title}
                width={400}
                height={300}
                style="width: 100%; height: auto; display: block;"
              />
            </div>
          </Card>
        ))
      }
    </div>
  </section>
</BaseLayout>
