---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroCard from '../../components/HeroCard.astro';
import Pill from '../../components/Pill.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const tutorials = await getCollection('tutorials');
  return tutorials.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Tutorials`}>
  <section class="container">
    <HeroCard>
        <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
            <a href="/tutorials/" style="text-decoration: none; color: var(--accent); font-weight: bold;">← Zurück</a>
            <Pill text={entry.data.level} />
            <span style="color: var(--muted);">{entry.data.time}</span>
        </div>
      <h1>{entry.data.title}</h1>
      {entry.data.image && (
          <div style="margin: 2rem 0; border-radius: 24px; overflow: hidden;">
            <Image 
                src={entry.data.image} 
                alt={entry.data.title} 
                width={800} 
                height={400} 
                style="width: 100%; height: auto; object-fit: cover;"
            />
          </div>
      )}
      <div class="content">
        <Content />
      </div>
    </HeroCard>
  </section>
</BaseLayout>

<style>
    .content :global(h1) { font-size: 2rem; margin-top: 2rem; }
    .content :global(h2) { font-size: 1.5rem; margin-top: 2rem; color: var(--accent); }
    .content :global(h3) { font-size: 1.2rem; margin-top: 1.5rem; }
    .content :global(p) { line-height: 1.6; margin-bottom: 1rem; }
    .content :global(ul) { padding-left: 1.5rem; margin-bottom: 1rem; }
    .content :global(li) { margin-bottom: 0.5rem; }
</style>
