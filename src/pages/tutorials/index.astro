---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import HeroCard from '../../components/HeroCard.astro';
import Pill from '../../components/Pill.astro';
import { getCollection } from 'astro:content';

const tutorials = await getCollection('tutorials');
---

<BaseLayout title="Tutorials | Granny Square Crochet">
  <section class="container">
    <div class="section-title">
      <div>
        <h1>Tutorials</h1>
        <p style="color: var(--muted); margin: 0;">
          Vom ersten Kreis bis zur texturierten Patchwork-Decke.
        </p>
      </div>
      <Pill text="4 neue Anleitungen" />
    </div>

    <div class="cards">
      {
        tutorials.map((tutorial) => (
          <Card
            title={tutorial.data.title}
            tag={tutorial.data.level}
            subtitle={tutorial.data.focus}
            content={tutorial.data.time}
          />
        ))
      }
    </div>
  </section>

  <section class="container">
    <HeroCard>
      <h2>Dein Projektplan</h2>
      <p>
        Materiallisten, Garnempfehlungen und ein klarer Zeitplan sorgen dafuer,
        dass jedes Square passt. Ergaenze deine Favoriten zu einer eigenen
        Sammlung.
      </p>
    </HeroCard>
  </section>
</BaseLayout>
