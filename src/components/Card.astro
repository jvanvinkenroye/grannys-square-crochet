---
// Card.astro - Wiederverwendbare Card-Komponente
// Props:
// - title: String (required)
// - subtitle: String (optional)
// - tag: String (optional)
// - content: String (optional)
// - style: String (optional)

interface Props {
  title: string;
  subtitle?: string;
  tag?: string;
  content?: string;
  style?: string;
}

const { title, subtitle, tag, content, style } = Astro.props;
---

<article class="card" style={style}>
  {tag && <span class="tag">{tag}</span>}
  <h3>{title}</h3>
  {
    subtitle && (
      <p style="color: var(--muted); margin: 0.4rem 0 0.8rem;">{subtitle}</p>
    )
  }
  {content && <p style="color: var(--muted); margin: 0;">{content}</p>}
  <slot />
</article>

<style>
  .card {
    padding: 1.5rem;
    background: var(--card);
    border-radius: 22px;
    box-shadow: var(--shadow);
    animation: reveal 0.8s ease forwards;
    opacity: 0;
  }

  .card:nth-child(2) {
    animation-delay: 0.1s;
  }

  .card:nth-child(3) {
    animation-delay: 0.2s;
  }

  .card:nth-child(4) {
    animation-delay: 0.3s;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(208, 95, 47, 0.12);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
  }
</style>
