---
// HeroCard.astro - Wiederverwendbare HeroCard-Komponente
// Props:
// - title: String (optional)
// - subtitle: String (optional)
// - style: String (optional)

interface Props {
  title?: string;
  subtitle?: string;
  style?: string;
}

const { title, subtitle, style } = Astro.props;
---

<div class="hero-card" style={style}>
  {title && <h2>{title}</h2>}
  {subtitle && <p>{subtitle}</p>}
  <slot />
</div>

<style>
  .hero-card {
    padding: 2.25rem;
    background: var(--card);
    border-radius: 28px;
    box-shadow: var(--shadow);
    animation: float-in 0.8s ease forwards;
  }

  .hero-card p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
