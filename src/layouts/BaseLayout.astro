---
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/animations.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';

const {
  title = 'Granny Square Crochet',
  description = 'Moderne Haeckel-Tutorials, eine inspirierende Galerie und klare Haeckelschriften.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- SEO Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.pathname} />
    <meta property="og:site_name" content="Granny Square Crochet" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@GrannySquareDE" />

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.pathname} />

    <!-- Favicon enhancements -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#d05f2f" />
    <meta name="msapplication-TileColor" content="#f6f0e8" />
    <meta name="theme-color" content="#f6f0e8" />
  </head>
  <body>
    <header class="site-header">
      <div
        class="container"
        style="display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between;"
      >
        <a class="brand" href="/">
          <img src="/logo.png" alt="Granny Square Logo" width="48" height="48" style="border-radius: 12px; display: block;">
          <span>Granny Square Crochet</span>
        </a>
        <nav>
          <a href="/tutorials/">Tutorials</a>
          <a href="/gallery/">Galerie</a>
          <a href="/haekelschrift/">Haeckelschrift</a>
          <a href="/about/">Ueber</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        Mit Liebe gehäkelt. Moderne Granny Squares, klare Anleitungen und ein
        kleines Archiv an Mustern.
      </div>
    </footer>
  </body>
</html>
