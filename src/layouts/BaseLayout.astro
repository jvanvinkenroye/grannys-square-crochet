---
import '../styles/variables.css';
import '../styles/base.css';
import '../styles/animations.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import { Image } from "astro:assets";
import catImage from "../assets/cat-gimmick.png";
import duckImage from "../assets/duck-gimmick.png";

const {
  title = 'Granny Square Crochet',
  description = 'Moderne Haeckel-Tutorials, eine inspirierende Galerie und klare Haeckelschriften.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- SEO Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.pathname} />
    <meta property="og:site_name" content="Granny Square Crochet" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@GrannySquareDE" />

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.pathname} />

    <!-- Favicon enhancements -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#d05f2f" />
    <meta name="msapplication-TileColor" content="#f6f0e8" />
    <meta name="theme-color" content="#f6f0e8" />
  </head>
  <body>
    <header class="site-header">
      <div
        class="container"
        style="display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between;"
      >
        <a class="brand" href="/">
          <img src="/logo.png" alt="Granny Square Logo" width="48" height="48" style="border-radius: 12px; display: block;">
          <span>Granny Square Crochet</span>
        </a>
        <nav>
          <a href="/tutorials/" class={Astro.url.pathname.startsWith('/tutorials') ? 'active' : ''}>Tutorials</a>
          <a href="/gallery/" class={Astro.url.pathname.startsWith('/gallery') ? 'active' : ''}>Galerie</a>
          <a href="/haekelschrift/" class={Astro.url.pathname.startsWith('/haekelschrift') ? 'active' : ''}>Haeckelschrift</a>
          <a href="/about/" class={Astro.url.pathname.startsWith('/about') ? 'active' : ''}>Ueber</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="gimmick-container">
          <Image src={duckImage} alt="Häkel-Ente" class="gimmick duck" width={100} />
          <Image src={catImage} alt="Häkel-Katze" class="gimmick cat" width={110} />
      </div>
      <div class="container relative-z">
        Mit Liebe gehäkelt. Moderne Granny Squares, klare Anleitungen und ein
        kleines Archiv an Mustern.
      </div>
    </footer>
  </body>
</html>

<style is:global>
  footer {
    position: relative;
    padding-top: 4rem;
    overflow: hidden;
  }
  
  .gimmick-container {
    pointer-events: none;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100px;
    z-index: 0;
  }

  .gimmick {
    position: absolute;
    bottom: -10px;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
    transition: transform 0.3s ease;
  }

  .gimmick.cat {
    right: 5%;
    transform: rotate(-5deg);
  }
  
  .gimmick.duck {
    left: 5%;
    transform: rotate(5deg);
  }

  .relative-z {
    position: relative;
    z-index: 1;
  }
</style>
