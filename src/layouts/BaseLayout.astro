---
const {
  title = "Granny Square Crochet",
  description = "Moderne Haeckel-Tutorials, eine inspirierende Galerie und klare Haeckelschriften.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Space+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #f6f0e8;
        --bg-alt: #efe3d4;
        --ink: #2e1f1a;
        --muted: #6f5d54;
        --accent: #d05f2f;
        --accent-soft: #f3b597;
        --card: #fffaf3;
        --shadow: 0 18px 40px rgba(46, 31, 26, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Helvetica", sans-serif;
        color: var(--ink);
        background: radial-gradient(circle at 10% 10%, #fff3e2 0%, transparent 55%),
          radial-gradient(circle at 80% 0%, #f2cbb6 0%, transparent 50%),
          linear-gradient(140deg, var(--bg), var(--bg-alt));
        min-height: 100vh;
      }

      h1,
      h2,
      h3 {
        font-family: "Fraunces", "Georgia", serif;
        margin: 0 0 0.5rem;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        width: min(1120px, 92vw);
        margin: 0 auto;
      }

      .site-header {
        padding: 2.5rem 0 1.5rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .brand-mark {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: conic-gradient(from 90deg, #f0a982, #d05f2f, #f0a982);
        box-shadow: inset 0 0 0 4px rgba(255, 255, 255, 0.6);
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-weight: 500;
        color: var(--muted);
      }

      nav a {
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.55);
      }

      nav a:hover {
        color: var(--ink);
        background: rgba(255, 255, 255, 0.9);
      }

      .hero {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 2.5rem;
        align-items: center;
        padding: 2.5rem 0 3rem;
      }

      .hero-card {
        padding: 2.25rem;
        background: var(--card);
        border-radius: 28px;
        box-shadow: var(--shadow);
        animation: float-in 0.8s ease forwards;
      }

      .hero-card p {
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.6;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--ink);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1.5rem;
      }

      .cta {
        padding: 0.75rem 1.4rem;
        border-radius: 999px;
        background: var(--accent);
        color: #fff;
        font-weight: 600;
      }

      .cta.secondary {
        background: transparent;
        border: 2px solid var(--accent);
        color: var(--accent);
      }

      section {
        padding: 2.5rem 0;
      }

      .section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
      }

      .card {
        padding: 1.5rem;
        background: var(--card);
        border-radius: 22px;
        box-shadow: var(--shadow);
        animation: reveal 0.8s ease forwards;
        opacity: 0;
      }

      .card:nth-child(2) {
        animation-delay: 0.1s;
      }

      .card:nth-child(3) {
        animation-delay: 0.2s;
      }

      .card:nth-child(4) {
        animation-delay: 0.3s;
      }

      .card h3 {
        margin-bottom: 0.4rem;
      }

      .tag {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        background: rgba(208, 95, 47, 0.12);
        color: var(--accent);
        font-size: 0.8rem;
        font-weight: 600;
      }

      footer {
        padding: 3rem 0 2.5rem;
        color: var(--muted);
        font-size: 0.9rem;
      }

      @keyframes float-in {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes reveal {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (max-width: 720px) {
        .site-header {
          padding: 1.5rem 0 1rem;
        }

        .hero-card {
          padding: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container" style="display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between;">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Granny Square Crochet</span>
        </a>
        <nav>
          <a href="/tutorials/">Tutorials</a>
          <a href="/gallery/">Galerie</a>
          <a href="/haekelschrift/">Haeckelschrift</a>
          <a href="/about/">Ueber</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        Mit Liebe gehäkelt. Moderne Granny Squares, klare Anleitungen und ein kleines Archiv an Mustern.
      </div>
    </footer>
  </body>
</html>
